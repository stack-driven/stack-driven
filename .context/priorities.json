{
  "meta": {
    "last_updated": "2025-11-10",
    "version": "1.0.0",
    "description": "Current priorities and decision criteria - TEMPLATE: Customize for your product",
    "template": true
  },
  "current_stage": "[pre_pmf | early_pmf | growth | scale]",
  "current_focus": {
    "primary": "[What matters most right now]",
    "secondary": "[What matters second]",
    "explicitly_not_now": ["[What we're NOT doing]", "[What we're NOT doing]"]
  },
  "quarterly_goal": {
    "quarter": "[Q1 2025]",
    "objective": "[Specific goal]",
    "key_results": [
      "[Metric]: [Current] → [Target]",
      "[Metric]: [Current] → [Target]",
      "[Metric]: [Current] → [Target]"
    ]
  },
  "roadmap": {
    "now": {
      "description": "Current quarter - committed work",
      "features": [
        {
          "name": "[Feature name]",
          "status": "[in_progress | planned]",
          "why": "[Impact on North Star or key metric]",
          "owner": "[Team/person]"
        }
      ]
    },
    "next": {
      "description": "1-2 quarters - planned work",
      "themes": [
        "[Theme 1 - high level]",
        "[Theme 2 - high level]"
      ]
    },
    "later": {
      "description": "3+ quarters - ideas",
      "possibilities": [
        "[Possibility 1]",
        "[Possibility 2]"
      ]
    },
    "never": {
      "description": "Explicitly decided not to build",
      "declined": [
        {
          "feature": "[Feature name]",
          "reason": "[Why not]"
        }
      ]
    }
  },
  "prioritization_framework": {
    "method": "RICE",
    "quick_win_threshold": {
      "effort": "< 3 days",
      "impact": "> 10% on key metric"
    },
    "must_have_criteria": [
      "Blocks mission outcome",
      "Required for monetization",
      "Legal/compliance requirement"
    ],
    "should_defer_if": [
      "< 5 user requests",
      "Low confidence (< 50%)",
      "No clear metric impact",
      "Not aligned with current stage"
    ]
  },
  "feature_request_evaluation": {
    "questions": [
      "How many users requested this?",
      "Does it align with mission?",
      "What's the underlying need?",
      "Can they pay for it now?",
      "Is there a workaround?"
    ],
    "approval_criteria": {
      "do_now": "RICE score > 500 AND aligns with quarterly goal",
      "do_next": "RICE score > 200 AND strategic fit",
      "do_later": "RICE score < 200 OR low confidence",
      "dont_do": "Misaligned with mission OR indifferent feature"
    }
  },
  "agent_guidance": {
    "decision_criteria": [
      "Prefer simple over clever (simple ships faster)",
      "Question scope (can we ship 20% for 80% value?)",
      "Consider maintenance burden",
      "Check reversibility (can we roll back?)",
      "Validate against current focus area"
    ],
    "implementation_bias": {
      "favor": ["quick_wins", "high_impact_low_effort", "current_quarter_goals"],
      "defer": ["edge_cases", "premature_optimization", "nice_to_haves"]
    }
  }
}
