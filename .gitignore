# Stack-Driven product guidelines directory (generated per user)
/product-guidelines/*
!/product-guidelines/.gitkeep

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
env/
ENV/

# Logs
*.log

# Temporary files
.tmp/
temp/

# gemini-cli settings
.gemini/

# GitHub App credentials
gha-creds-*.json

# Review artifacts (generated during code review)
pr-review*.md
issue-*-evaluation.md

# Debugging memory (user-specific tracking state)
.claude/memory/*.json

# Ephemeral artifacts (generated during cascade, not committed)
.github/ISSUE-PLAN.json

# Cascade state tracking (user-specific session state)
.cascade/
